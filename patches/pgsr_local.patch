+def run_command(command, step):
+    """Run a command and stop on the first failure."""
+    print(f"\n[{step}] {subprocess.list2cmdline(command)}")
+    try:
+        subprocess.run(command, check=True)
+    except FileNotFoundError as exc:
+        raise RuntimeError(f"{step} failed: executable not found: {command[0]}") from exc
+    except subprocess.CalledProcessError as exc:
+        raise RuntimeError(f"{step} failed with exit code {exc.returncode}") from exc
+
+
+def reset_output(path):
+    """Remove a previous generated output and recreate its directory."""
+    if os.path.isdir(path):
+        shutil.rmtree(path)
+    elif os.path.exists(path):
+        os.remove(path)
+    os.makedirs(path, exist_ok=True)
+
+
+def find_scenes(data_path):
+    """Accept either one scene directory or a parent containing scenes."""
+    data_path = os.path.abspath(data_path)
+    if os.path.isdir(os.path.join(data_path, "input")):
+        return [data_path]
+
+    scenes = []
+    for name in sorted(os.listdir(data_path)):
+        scene_path = os.path.join(data_path, name)
+        if os.path.isdir(os.path.join(scene_path, "input")):
+            scenes.append(scene_path)
+    return scenes
+
+
+def preprocess_scene(scene_path, args):
+    colmap = args.colmap_executable or "colmap"
+    use_gpu = "0" if args.no_gpu else "1"
+    input_path = os.path.join(scene_path, "input")
+    database_path = os.path.join(scene_path, "database.db")
+    sparse_path = os.path.join(scene_path, "sparse")
+    images_path = os.path.join(scene_path, "images")
+
+    input_images = [
+        name for name in os.listdir(input_path)
+        if os.path.isfile(os.path.join(input_path, name))
+        and os.path.splitext(name)[1].lower()
+        in {".jpg", ".jpeg", ".png", ".tif", ".tiff"}
+    ]
+    if not input_images:
+        raise RuntimeError(f"No images found in {input_path}")
+
+    print(f"\n=== Scene: {scene_path} ({len(input_images)} images) ===")
+
+    # Rebuild generated files while preserving the original input images.
+    if os.path.exists(database_path):
+        os.remove(database_path)
+    reset_output(sparse_path)
+    if os.path.exists(images_path):
+        reset_output(images_path)
+
+    run_command([
+        colmap, "feature_extractor",
+        "--database_path", database_path,
+        "--image_path", input_path,
+        "--ImageReader.single_camera", "1",
+        "--ImageReader.camera_model", args.camera,
+        "--FeatureExtraction.use_gpu", use_gpu,
+    ], "Feature extraction")
+
+    run_command([
+        colmap, "exhaustive_matcher",
+        "--database_path", database_path,
+        "--FeatureMatching.use_gpu", use_gpu,
+    ], "Feature matching")
+
+    run_command([
+        colmap, "mapper",
+        "--database_path", database_path,
+        "--image_path", input_path,
+        "--output_path", sparse_path,
+        "--Mapper.ba_global_function_tolerance", "0.000001",
+    ], "Sparse reconstruction")
+
+    model_path = os.path.join(sparse_path, "0")
+    if not os.path.isdir(model_path):
